# nexc-engine configuration (one .env at the repo root, shared by every service).
#
#   make init      # copies this file to .env and generates every secret below
#
# The full reference is docs/CONTRACT.md section 2. Never commit your .env.
# Values below are safe local-development defaults; Docker Compose and Kubernetes override the
# host names and bind addresses for their networks.

# --- Core ---------------------------------------------------------------------------------------
# development | production (production forces secure cookies, HSTS and refuses weak secrets)
NEXC_ENV=development
# 127.0.0.1 keeps the local dev API private to this machine (containers bind 0.0.0.0 themselves).
NEXC_HOST=127.0.0.1
NEXC_PORT=8080
# Where artifacts (<data>/artifacts/<run_id>/...) and managed files live.
NEXC_DATA_DIR=./data
NEXC_LOG=info

# --- PostgreSQL 17 (the only database) ----------------------------------------------------------
# `make db-up` starts postgres:17-alpine on localhost:5432 with these credentials.
POSTGRES_USER=nexc
POSTGRES_PASSWORD=
POSTGRES_DB=nexc
# Host port for `make db-up` (change it if another PostgreSQL already uses 5432).
NEXC_DB_PORT=5432
# Dev database image and volume (scripts/db.sh). For vector search over memories and documents,
# build deploy/postgres/pgvector.Dockerfile as nexc-postgres-pgvector:17 and name a NEW volume;
# move existing data with pg_dump/pg_restore, never by pointing the new image at the old volume.
# NEXC_DB_IMAGE=nexc-postgres-pgvector:17
# NEXC_DB_VOLUME=nexc-pgdata-pgvector
# Written by `make init` from the three values above. Use sslmode=require outside development.
NEXC_DATABASE_URL=
NEXC_DB_MAX_CONNECTIONS=20

# --- Secrets (generated by `make init` / `nexc init`) -------------------------------------------
# HS256 signing secret, >= 32 bytes.
NEXC_JWT_SECRET=
# base64 of 32 random bytes; AES-256-GCM key for stored LLM API keys. Losing it makes stored keys
# unreadable, so back it up together with the database.
NEXC_MASTER_KEY=
# Shared bearer secret between the backend and the agent runtime, >= 32 chars.
NEXC_RUNTIME_TOKEN=
# The per-run agent tokens are signed by the backend alone (Ed25519). Its seed, base64 of 32
# bytes (`openssl rand -base64 32`); leave empty to derive it from NEXC_MASTER_KEY. Never give it
# to the runtime. NEXC_AGENT_TOKEN_KEY (the shared HS256 key of earlier releases) is refused.
NEXC_AGENT_TOKEN_SIGNING_KEY=
# Backend: more public keys (base64url) that verify agent tokens and are published, during a
# rotation (docs/CONTRACT.md §8).
NEXC_AGENT_TOKEN_VERIFY_KEYS=
# Runtime: the backend's key set. `make dev` runs the backend here; Docker Compose and Kubernetes
# set their own (the backend's key-set port, NEXC_KEYS_ADDR). Or pin the backend's public keys in
# NEXC_AGENT_TOKEN_PUBLIC_KEYS instead (never both).
NEXC_AGENT_TOKEN_JWKS_URL=http://localhost:8080/api/v1/agent-tokens/jwks.json
# Ed25519 seed (base64 of 32 bytes) the Agent Firewall API signs its decisions with. Leave
# empty to derive it from NEXC_MASTER_KEY; set one to rotate it apart from the master key.
NEXC_FIREWALL_SIGNING_KEY=
# Bearer token for GET /metrics (admins can also use their access token).
NEXC_METRICS_TOKEN=

# --- HTTP / auth --------------------------------------------------------------------------------
NEXC_CORS_ORIGINS=http://localhost:5173
# Secure refresh cookie; defaults to true when NEXC_ENV=production.
NEXC_COOKIE_SECURE=false
NEXC_ALLOW_SIGNUP=true
# Trust X-Forwarded-For from a reverse proxy (set true behind nginx / an ingress).
NEXC_TRUST_PROXY=false
# Bootstrap a platform administrator on first start when both are set (password >= 12 chars).
# It signs in to the platform console only and never works inside a workspace.
NEXC_ADMIN_EMAIL=
NEXC_ADMIN_PASSWORD=
NEXC_ACCESS_TTL_SECS=900
NEXC_REFRESH_TTL_SECS=1209600

# --- Single sign-on (OpenID Connect, optional) ---------------------------------------------------
# Set the issuer to turn it on; unset, every other NEXC_OIDC_* setting is ignored. The provider
# needs a confidential client with the authorization code flow and this redirect URL registered:
# NEXC_PUBLIC_URL + /api/v1/auth/oidc/callback, so NEXC_PUBLIC_URL must be the console's public
# address (http://localhost:5173 under `make dev`). `nexc doctor` fetches the issuer's discovery
# document. Guide: site/operate/sso.md.
# NEXC_OIDC_ISSUER=https://idp.example.com/realms/acme
# NEXC_OIDC_CLIENT_ID=nexc
# NEXC_OIDC_CLIENT_SECRET=
# Only when NEXC_PUBLIC_URL cannot be the console's address: the console's own host followed by
# /api/v1/auth/oidc/callback (any other path is refused).
# NEXC_OIDC_REDIRECT_URL=
# Scopes separated by spaces (quote the value) or commas; openid is always asked for.
# NEXC_OIDC_SCOPES="openid email profile"
# The login page's button says "Continue with <this>" (quote a name with a space).
# NEXC_OIDC_DISPLAY_NAME=SSO
# The claim listing the person's groups, in the ID token or the userinfo answer.
# NEXC_OIDC_GROUPS_CLAIM=groups
# Members of these groups (comma separated) administer the platform.
# NEXC_OIDC_ADMIN_GROUPS=
# Workspace roles by group, applied at every sign-in: group=workspace:role, comma separated;
# the workspace by its id (the platform console's Workspaces shows it; never a slug, which anyone
# creating a workspace of that name could take), the role owner, admin, member or guest. A role
# the mapping gave is taken back at the first sign-in without the group.
# NEXC_OIDC_WORKSPACE_ROLES=engineering=0190f3a2-7b1c-7d2e-8f00-00000000ac3e:member,nexc-leads=0190f3a2-7b1c-7d2e-8f00-00000000ac3e:admin
# false hides and refuses password sign-in, except for the break-glass platform administrator.
# NEXC_OIDC_ALLOW_LOCAL_LOGIN=true
# NEXC_OIDC_BREAK_GLASS_EMAIL=
# Refuse an identity whose provider does not say its e-mail address is verified.
# NEXC_OIDC_REQUIRE_VERIFIED_EMAIL=true

# --- LLM ----------------------------------------------------------------------------------------
# anthropic | openai_compatible | claude_code | demo
# `demo` is a deterministic offline provider: the whole product works with no API key and every
# output is labelled as demo content. `make init` keeps demo while ANTHROPIC_API_KEY is empty;
# set a key (here or per user in Settings -> LLM) and switch to anthropic for real results.
# `claude_code` runs the local Claude Code CLI with its own login (no API key) - for `make dev`
# on a machine where `claude` is installed and logged in; use NEXC_LLM_MODEL=claude-sonnet-5,
# `sonnet` or `haiku` for cheaper runs.
NEXC_LLM_PROVIDER=demo
NEXC_LLM_MODEL=claude-opus-5
# Provider base URL override, e.g. http://localhost:11434/v1 for Ollama (openai_compatible).
NEXC_LLM_BASE_URL=
# Anthropic server-side refusal fallbacks (fallbacks: "default").
NEXC_LLM_FALLBACKS=true
# Server-wide default key; a user's own stored key wins.
ANTHROPIC_API_KEY=

# Knowledge base embeddings: an OpenAI-compatible /embeddings endpoint. Leave unset to use the
# built-in embedding (matches words, not meaning; needs no service). A workspace can set its own
# under Settings -> Knowledge.
NEXC_EMBED_BASE_URL=
NEXC_EMBED_MODEL=
NEXC_EMBED_API_KEY=
# Ask the endpoint for vectors of this size, when the model can shorten them.
NEXC_EMBED_DIMS=

# Claude Code CLI used by the claude_code provider (backend and agent runtime).
NEXC_CLAUDE_BIN=claude
RUNTIME_CLAUDE_BIN=claude

# --- Agent runtime (Python) ---------------------------------------------------------------------
NEXC_RUNTIME_URL=http://localhost:8090
# How the backend speaks to the runtime: `grpc` (one AgentRuntime/Execute stream per node,
# CONTRACT section 8) or `ndjson` (POST /v1/execute, kept for one release).
NEXC_RUNTIME_PROTOCOL=grpc
NEXC_RUNTIME_GRPC_URL=http://localhost:8095
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8090
# The runtime's gRPC stream, next to its HTTP port; 0 turns it off.
RUNTIME_GRPC_PORT=8095
RUNTIME_WORKSPACE=/tmp/nexc-runtime
# Enables the sandboxed run_python tool. Keep false unless you need it.
RUNTIME_ALLOW_CODE_EXEC=false
RUNTIME_LOG_LEVEL=info

# --- Scheduler ----------------------------------------------------------------------------------
NEXC_MAX_CONCURRENCY=4
NEXC_MAX_ATTEMPTS=3
NEXC_NODE_TIMEOUT_SECS=600
# The lease a backend instance holds on a run it executes, renewed every third of it. A run whose
# lease ran out (its instance crashed or lost the database) is taken over by another instance,
# which resumes it from what was written (docs/HA.md). Set the same value on every replica; at
# least 10 with NEXC_ENV=production.
NEXC_RUN_LEASE_SECS=30

# --- texc-symphony (optional coding-task executor) ----------------------------------------------
NEXC_SYMPHONY_ENABLED=false
NEXC_SYMPHONY_URL=http://localhost:4000
NEXC_SYMPHONY_WORKFLOW=./data/symphony/WORKFLOW.md
# Agent that Symphony runs for each coding node. Empty = Symphony's default (Codex CLI). To use
# your logged-in Claude Code CLI instead, point it at the adapter with an absolute path, e.g.
# NEXC_SYMPHONY_AGENT_COMMAND=/path/to/nexc-engine/scripts/symphony-claude-agent.py
NEXC_SYMPHONY_AGENT_COMMAND=

# Authenticated API requests one account may make per minute (burst a fifth of it). Raise it
# for load tests (`make prove-api` sets it on its own test server) and for automation accounts.
NEXC_API_CALLS_PER_MINUTE=600

# Hot-read caches (agent cards, resolved policies, guardrails, workspace LLM settings): the longest an
# entry lives; a write drops it on every replica at once. 0 turns them off.
NEXC_CACHE_TTL_SECS=60

# --- gRPC channels (runtime, onto-intelli, OTLP collector) and the Agent Firewall server ----------
# HTTP/2 keepalive: a PING every NEXC_GRPC_KEEPALIVE_SECS, dropped after NEXC_GRPC_KEEPALIVE_TIMEOUT_SECS
# without an answer; NEXC_GRPC_POOL_SIZE connections per client channel, kept for the life of the
# process (streams and requests are spread over them).
NEXC_GRPC_KEEPALIVE_SECS=30
NEXC_GRPC_KEEPALIVE_TIMEOUT_SECS=10
NEXC_GRPC_POOL_SIZE=2

# --- LLM circuit breaker ---------------------------------------------------------------------------
# After NEXC_LLM_BREAKER_FAILURES consecutive failures of one provider endpoint (429, 5xx, no
# connection) its circuit opens: calls fail at once for NEXC_LLM_BREAKER_OPEN_SECS, then one probe
# goes out. 0 failures turns the breaker off.
NEXC_LLM_BREAKER_FAILURES=5
NEXC_LLM_BREAKER_OPEN_SECS=30

# --- Tools gateway --------------------------------------------------------------------------------
# External calls of agents (MCP servers registered per workspace, fetch_url) are performed by
# the backend, never by the runtime: per agent per minute, per-call timeout, response size cap.
NEXC_GATEWAY_CALLS_PER_MINUTE=120
NEXC_GATEWAY_TIMEOUT_SECS=30
NEXC_GATEWAY_MAX_RESPONSE_BYTES=1048576

# --- Alert routing ---------------------------------------------------------------------------------
# Alerts and approvals go to the destinations a workspace registers (signed JSON webhooks, Slack).
# NEXC_PUBLIC_URL is where the console is reached from outside: the links every delivery carries.
# Destinations on private or loopback hosts are refused unless NEXC_ALERT_ALLOW_PRIVATE_HOSTS=true
# (development only: a receiver on this machine).
NEXC_PUBLIC_URL=http://localhost:8080
NEXC_ALERT_ALLOW_PRIVATE_HOSTS=false

# --- A2A adapter ------------------------------------------------------------------------------------
# Agents an admin exposes serve an agent card at /.well-known/agent.json?agent= and take tasks at
# /a2a/agents/{principal}; agents call registered counterparts as the gateway tool a2a:<name>.
# NEXC_A2A_TIMEOUT_SECS bounds one outbound task (the remote agent's work included). A counterpart on
# a private or loopback host is refused at registration unless NEXC_A2A_ALLOW_PRIVATE_HOSTS=true
# (development only); at call time the agent's egress allow-list must still name such a host.
NEXC_A2A_TIMEOUT_SECS=120
NEXC_A2A_ALLOW_PRIVATE_HOSTS=false

# --- Agent Firewall API (optional) ----------------------------------------------------------------
# Where the gRPC Agent Firewall API listens (AuthorizeAction, ReportSpan, VerifyTrace,
# GetAgentCard, with reflection and grpc.health.v1), for agents that run elsewhere and hold an
# API token. Empty keeps it off. Service to service only: never publish it to browsers.
NEXC_GRPC_ADDR=

# --- OpenTelemetry (optional) ---------------------------------------------------------------------
# OTLP/gRPC endpoint of a collector; the trace spine is exported as spans (the run is the
# trace, each workspace a resource). Empty keeps it off.
NEXC_OTLP_ENDPOINT=

# --- onto-intelli: where the ontology lives (docs/ONTOLOGY.md) ----------------------------------
# onto-intelli (https://github.com/f8fvwgzc/onto-intelli) holds every graph's node and relation
# types, the workspace map (its own UI, embedded by the console), the audit's facts and the
# schema with its proposals: one tenant per workspace (ws_<id>), every call made as the member.
# service: over gRPC to `onto serve` at NEXC_ONTO_URL (the default when it is set);
# embedded: not in this build (docs/ONTOLOGY.md says what it needs); off: graphs keep the
# read-only starter vocabulary, no map, no proposals, no audit questions (the default without a URL).
NEXC_ONTO_MODE=
# gRPC and HTTP endpoint of `onto serve`. `make dev` starts one from ../onto-intelli on
# http://127.0.0.1:50051 when NEXC_ONTO_MODE=service; `make demo-onto` runs one in Compose.
NEXC_ONTO_URL=
# Bearer token onto-intelli knows the backend by (`impersonate = true` in its [[auth.tokens]]);
# generated by `make init`. It never reaches a browser.
NEXC_ONTO_TOKEN=
# Each nexc workspace's entities live in the onto-intelli workspace `{prefix}{workspace id}`.
NEXC_ONTO_WORKSPACE_PREFIX=nexc-
# Where browsers reach `onto serve` (its UI at /ui/, embedded as the workspace map; the console's
# Content-Security-Policy allows framing its origin); empty: NEXC_ONTO_URL.
NEXC_ONTO_PUBLIC_URL=
# How long a graph's vocabulary is served from memory before onto-intelli is asked again (0: always
# ask); a change made through nexc is seen at once on every replica.
NEXC_ONTO_VOCABULARY_TTL_SECS=30
# Lifetime of the browser session the console mints for onto-intelli's UI (60-43200 seconds).
NEXC_ONTO_SESSION_TTL_SECS=3600
# Copy every graph's stored ontology into onto-intelli at start (`nexc onto migrate`; once per graph).
NEXC_ONTO_MIGRATE_ON_START=true
# onto-intelli's side, read by `onto serve` (Compose, `make dev`): signs its browser sessions, the
# same on every replica (32+ characters; generated by `make init`).
ONTO_SESSION_SECRET=
# onto-intelli's own PostgreSQL login in Compose (the `onto-postgres` service, user `onto`) and on
# the Helm chart's PostgreSQL (role `onto`, owning its database only); generated by `make init`.
ONTO_POSTGRES_PASSWORD=
# Compose (docker-compose.onto.yml): an onto-intelli image you built and pushed, to pull instead of
# building ../onto-intelli (it publishes none yet), and the host port browsers reach its UI on.
# ONTO_IMAGE=registry.example.com/onto-intelli:<tag>
# ONTO_HTTP_PORT=8081

# --- Frontend -----------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# --- Docker Compose -----------------------------------------------------------------------------
# Host port of the web UI (nginx) in `docker compose up`.
NEXC_HTTP_PORT=8080
# Image tag for docker-compose.yml: `latest` pulls the published release images when they exist
# and otherwise builds from source; `make docker-up` always rebuilds from source.
NEXC_IMAGE_TAG=latest
# Backend replicas in `docker compose up`. 2 or more: a run survives the loss of the replica
# executing it (docs/HA.md); run `docker compose restart frontend` after changing it.
NEXC_BACKEND_REPLICAS=1
