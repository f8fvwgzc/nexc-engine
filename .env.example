# nexc-engine configuration (one .env at the repo root, shared by every service).
#
#   make init      # copies this file to .env and generates every secret below
#
# The full reference is docs/CONTRACT.md section 2. Never commit your .env.
# Values below are safe local-development defaults; Docker Compose and Kubernetes override the
# host names and bind addresses for their networks.

# --- Core ---------------------------------------------------------------------------------------
# development | production (production forces secure cookies, HSTS and refuses weak secrets)
NEXC_ENV=development
# 127.0.0.1 keeps the local dev API private to this machine (containers bind 0.0.0.0 themselves).
NEXC_HOST=127.0.0.1
NEXC_PORT=8080
# Where artifacts (<data>/artifacts/<run_id>/...) and managed files live.
NEXC_DATA_DIR=./data
NEXC_LOG=info

# --- PostgreSQL 17 (the only database) ----------------------------------------------------------
# `make db-up` starts postgres:17-alpine on localhost:5432 with these credentials.
POSTGRES_USER=nexc
POSTGRES_PASSWORD=
POSTGRES_DB=nexc
# Host port for `make db-up` (change it if another PostgreSQL already uses 5432).
NEXC_DB_PORT=5432
# Dev database image and volume (scripts/db.sh). For vector search over memories and documents,
# build deploy/postgres/pgvector.Dockerfile as nexc-postgres-pgvector:17 and name a NEW volume;
# move existing data with pg_dump/pg_restore, never by pointing the new image at the old volume.
# NEXC_DB_IMAGE=nexc-postgres-pgvector:17
# NEXC_DB_VOLUME=nexc-pgdata-pgvector
# Written by `make init` from the three values above. Use sslmode=require outside development.
NEXC_DATABASE_URL=
NEXC_DB_MAX_CONNECTIONS=20

# --- Secrets (generated by `make init` / `nexc init`) -------------------------------------------
# HS256 signing secret, >= 32 bytes.
NEXC_JWT_SECRET=
# base64 of 32 random bytes; AES-256-GCM key for stored LLM API keys. Losing it makes stored keys
# unreadable, so back it up together with the database.
NEXC_MASTER_KEY=
# Shared bearer secret between the backend and the agent runtime, >= 32 chars.
NEXC_RUNTIME_TOKEN=
# Bearer token for GET /metrics (admins can also use their access token).
NEXC_METRICS_TOKEN=

# --- HTTP / auth --------------------------------------------------------------------------------
NEXC_CORS_ORIGINS=http://localhost:5173
# Secure refresh cookie; defaults to true when NEXC_ENV=production.
NEXC_COOKIE_SECURE=false
NEXC_ALLOW_SIGNUP=true
# Trust X-Forwarded-For from a reverse proxy (set true behind nginx / an ingress).
NEXC_TRUST_PROXY=false
# Bootstrap a platform administrator on first start when both are set (password >= 12 chars).
# It signs in to the platform console only and never works inside a workspace.
NEXC_ADMIN_EMAIL=
NEXC_ADMIN_PASSWORD=
NEXC_ACCESS_TTL_SECS=900
NEXC_REFRESH_TTL_SECS=1209600

# --- LLM ----------------------------------------------------------------------------------------
# anthropic | openai_compatible | claude_code | demo
# `demo` is a deterministic offline provider: the whole product works with no API key and every
# output is labelled as demo content. `make init` keeps demo while ANTHROPIC_API_KEY is empty;
# set a key (here or per user in Settings -> LLM) and switch to anthropic for real results.
# `claude_code` runs the local Claude Code CLI with its own login (no API key) - for `make dev`
# on a machine where `claude` is installed and logged in; use NEXC_LLM_MODEL=claude-sonnet-5,
# `sonnet` or `haiku` for cheaper runs.
NEXC_LLM_PROVIDER=demo
NEXC_LLM_MODEL=claude-opus-5
# Provider base URL override, e.g. http://localhost:11434/v1 for Ollama (openai_compatible).
NEXC_LLM_BASE_URL=
# Anthropic server-side refusal fallbacks (fallbacks: "default").
NEXC_LLM_FALLBACKS=true
# Server-wide default key; a user's own stored key wins.
ANTHROPIC_API_KEY=

# Knowledge base embeddings: an OpenAI-compatible /embeddings endpoint. Leave unset to use the
# built-in embedding (matches words, not meaning; needs no service). A workspace can set its own
# under Settings -> Knowledge.
NEXC_EMBED_BASE_URL=
NEXC_EMBED_MODEL=
NEXC_EMBED_API_KEY=
# Ask the endpoint for vectors of this size, when the model can shorten them.
NEXC_EMBED_DIMS=

# Claude Code CLI used by the claude_code provider (backend and agent runtime).
NEXC_CLAUDE_BIN=claude
RUNTIME_CLAUDE_BIN=claude

# --- Agent runtime (Python) ---------------------------------------------------------------------
NEXC_RUNTIME_URL=http://localhost:8090
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8090
RUNTIME_WORKSPACE=/tmp/nexc-runtime
# Enables the sandboxed run_python tool. Keep false unless you need it.
RUNTIME_ALLOW_CODE_EXEC=false
RUNTIME_LOG_LEVEL=info

# --- Scheduler ----------------------------------------------------------------------------------
NEXC_MAX_CONCURRENCY=4
NEXC_MAX_ATTEMPTS=3
NEXC_NODE_TIMEOUT_SECS=600

# --- texc-symphony (optional coding-task executor) ----------------------------------------------
NEXC_SYMPHONY_ENABLED=false
NEXC_SYMPHONY_URL=http://localhost:4000
NEXC_SYMPHONY_WORKFLOW=./data/symphony/WORKFLOW.md
# Agent that Symphony runs for each coding node. Empty = Symphony's default (Codex CLI). To use
# your logged-in Claude Code CLI instead, point it at the adapter with an absolute path, e.g.
# NEXC_SYMPHONY_AGENT_COMMAND=/path/to/nexc-engine/scripts/symphony-claude-agent.py
NEXC_SYMPHONY_AGENT_COMMAND=

# --- Frontend -----------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# --- Docker Compose -----------------------------------------------------------------------------
# Host port of the web UI (nginx) in `docker compose up`.
NEXC_HTTP_PORT=8080
# Image tag for docker-compose.yml: `latest` pulls the published release images when they exist
# and otherwise builds from source; `make docker-up` always rebuilds from source.
NEXC_IMAGE_TAG=latest
