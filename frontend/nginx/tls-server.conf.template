# HTTPS with HTTP/2, and HTTP/3 over QUIC on the same port (UDP), serving the same site as the
# plain listener (docs/adr/0001-http3-edge-caching-and-indexes.md). Written to
# /tmp/nginx/tls-server.conf by /docker-entrypoint.d/41-nexc-tls.sh when /etc/nginx/tls holds
# tls.crt and tls.key; __PUBLIC_PORT__ is the port browsers reach (NEXC_HTTPS_PUBLIC_PORT),
# which Alt-Svc advertises.
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    # reuseport: every worker has a UDP socket of its own, and the packets of a QUIC connection
    # reach the worker that holds it.
    listen 8443 quic reuseport;
    listen [::]:8443 quic reuseport;
    http2 on;
    http3 on;

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    # QUIC is TLS 1.3 only; TCP clients may still use 1.2.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:nexc_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # 0-RTT data can be replayed by anyone who saw it, and the API takes writes.
    ssl_early_data off;

    # A browser learns of HTTP/3 from this header on an HTTPS answer, and uses it from then on
    # for a day; it falls back to HTTP/2 over TCP by itself when UDP does not get through.
    set $alt_svc 'h3=":__PUBLIC_PORT__"; ma=86400';

    include /etc/nginx/nexc/site.conf;
}
