# Non-secret configuration (ConfigMap nexc-config). Secrets live in secret.env.
# `development` because the minikube setup serves plain http://nexc.local and production mode
# forces Secure cookies. For a real deployment terminate TLS in the ingress, then set
# NEXC_ENV=production, NEXC_COOKIE_SECURE=true, NEXC_CORS_ORIGINS=https://<your host> and
# NEXC_PUBLIC_URL=https://<your host> (A2A cards, alert links and the SSO callback carry it;
# docs/INFRASTRUCTURE.md, Serving it on a host of its own).
NEXC_ENV=development
NEXC_HOST=0.0.0.0
NEXC_PORT=8080
NEXC_DATA_DIR=/data
NEXC_LOG=info
# The PostgreSQL pool of each backend pod (the realtime LISTEN connection is one of it). Every pod
# that can run at once fills its pool: 2 replicas plus the one a rollout adds is 3 x 20 = 60, under
# postgres.yaml's max_connections of 100 less a few for psql, backups and the superuser. Scaling
# the backend up, or adding onto-intelli's pool, means a smaller pool here or a higher
# max_connections there (docs/HA.md, Connections to PostgreSQL).
NEXC_DB_MAX_CONNECTIONS=20
NEXC_CORS_ORIGINS=http://nexc.local
NEXC_COOKIE_SECURE=false
NEXC_ALLOW_SIGNUP=true
NEXC_TRUST_PROXY=true
NEXC_ACCESS_TTL_SECS=900
NEXC_REFRESH_TTL_SECS=1209600
NEXC_LLM_PROVIDER=demo
NEXC_LLM_MODEL=claude-opus-5
NEXC_LLM_FALLBACKS=true
NEXC_RUNTIME_URL=http://agent-runtime:8090
NEXC_RUNTIME_PROTOCOL=grpc
NEXC_RUNTIME_GRPC_URL=http://agent-runtime:8095
NEXC_GATEWAY_CALLS_PER_MINUTE=120
NEXC_GATEWAY_TIMEOUT_SECS=30
NEXC_GATEWAY_MAX_RESPONSE_BYTES=1048576
NEXC_A2A_TIMEOUT_SECS=120
# Public keys (hex or base64) of signing keys rotated out, still published at
# /.well-known/jwks.json so what they signed verifies (docs/AGENTSECOPS.md §12).
NEXC_SIGNING_KEYS_RETIRED=
NEXC_SYMPHONY_ENABLED=false
NEXC_SYMPHONY_URL=http://texc-symphony:4000
NEXC_SYMPHONY_WORKFLOW=/data/symphony/WORKFLOW.md
NEXC_MAX_CONCURRENCY=4
NEXC_MAX_ATTEMPTS=3
NEXC_NODE_TIMEOUT_SECS=600
NEXC_RUN_LEASE_SECS=30
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8090
RUNTIME_GRPC_PORT=8095
RUNTIME_WORKSPACE=/workspace
RUNTIME_ALLOW_CODE_EXEC=false
RUNTIME_LOG_LEVEL=info
# The backend's second listener: the agent-token key set alone, the one port of the backend the
# runtime may reach (networkpolicies.yaml).
NEXC_KEYS_ADDR=0.0.0.0:8081
# What runtime-egress, the runtime's only way out, lets through: host[:port], comma separated,
# 443 when no port is given, `*.example.com` for subdomains. Add a local provider's host:port here
# (e.g. ollama.llm.svc.cluster.local:11434) and a rule for it to the runtime-egress-out policy.
NEXC_RUNTIME_EGRESS_ALLOW=api.anthropic.com:443
