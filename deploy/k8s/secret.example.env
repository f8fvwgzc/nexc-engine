# Template for secret.env (git-ignored). Create it with: scripts/init-env.sh --k8s
# Empty values are generated; anything you set is kept.
POSTGRES_USER=nexc
POSTGRES_DB=nexc
POSTGRES_PASSWORD=
NEXC_DATABASE_URL=
NEXC_JWT_SECRET=
NEXC_MASTER_KEY=
NEXC_RUNTIME_TOKEN=
# Optional: base64 of 32 bytes, the Ed25519 seed the backend alone signs agent tokens with; derived
# from NEXC_MASTER_KEY when empty. The runtime never gets it (it fetches the public keys).
NEXC_AGENT_TOKEN_SIGNING_KEY=
# Optional: public keys (base64url) that verify agent tokens too, during a rotation.
NEXC_AGENT_TOKEN_VERIFY_KEYS=
NEXC_METRICS_TOKEN=
# Signs run seals, firewall decisions and evidence bundles (base64 of 32 bytes); generated for a new
# secret.env. Keep it with your backups: seals verify only against the keys published from it.
# Rotating it: docs/AGENTSECOPS.md §12 (the old public key goes in NEXC_SIGNING_KEYS_RETIRED, in
# config.env).
NEXC_SIGNING_KEY=
# onto-intelli (optional; docs/ONTOLOGY.md): the backend's token toward it, the key its browser
# sessions are signed with, and its own PostgreSQL login (role `onto`, owning its database only).
NEXC_ONTO_TOKEN=
ONTO_SESSION_SECRET=
ONTO_POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=
NEXC_ADMIN_EMAIL=
NEXC_ADMIN_PASSWORD=
