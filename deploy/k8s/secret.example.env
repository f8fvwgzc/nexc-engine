# Template for secret.env (git-ignored). Create it with: scripts/init-env.sh --k8s
# Empty values are generated; anything you set is kept.
POSTGRES_USER=nexc
POSTGRES_DB=nexc
POSTGRES_PASSWORD=
NEXC_DATABASE_URL=
NEXC_JWT_SECRET=
NEXC_MASTER_KEY=
NEXC_RUNTIME_TOKEN=
# Optional: signs the per-run agent tokens (>= 32 chars); derived from NEXC_RUNTIME_TOKEN when empty.
NEXC_AGENT_TOKEN_KEY=
NEXC_METRICS_TOKEN=
# onto-intelli (optional; docs/ONTOLOGY.md): the backend's token toward it, and the key its
# browser sessions are signed with.
NEXC_ONTO_TOKEN=
ONTO_SESSION_SECRET=
ANTHROPIC_API_KEY=
NEXC_ADMIN_EMAIL=
NEXC_ADMIN_PASSWORD=
